{
  "canonicalTerms": [
    { "term": "Wi-Fi", "note": "Use in prose for wireless networking." },
    { "term": "`no_std`", "note": "Use code formatting in prose for the Rust no-std environment." },
    { "term": "ESP32-C3", "note": "Preferred chip name spelling." },
    { "term": "Espressif", "note": "Preferred company name spelling in prose." },
    { "term": "ESP-IDF", "note": "Use in prose; lowercase may appear in package names, commands, paths, or URLs." },
    { "term": "MQTT", "note": "Use uppercase acronym in prose." },
    { "term": "OTA", "note": "Use uppercase acronym in prose." },
    { "term": "SoC", "note": "Use this capitalization for system-on-chip." },
    { "term": "eFuse", "note": "Use this capitalization." },
    { "term": "Cargo", "note": "Capitalize the Rust package manager in prose." },
    { "term": "Rust", "note": "Capitalize the programming language name." }
  ],
  "deterministicChecks": [
    {
      "id": "wifi-spelling",
      "preferred": "Wi-Fi",
      "patterns": ["\\b(?:wifi|Wifi|WIFI|WiFi|wi-fi|Wi-fi|WI-FI)\\b"],
      "severity": "error",
      "message": "Use 'Wi-Fi' in prose."
    },
    {
      "id": "no-std-formatting",
      "preferred": "`no_std`",
      "patterns": ["\\bno[-_]std\\b"],
      "severity": "warning",
      "message": "Use '`no_std`' in prose; keep exact spelling in commands, paths, repository names, and code."
    },
    {
      "id": "esp-idf-capitalization",
      "preferred": "ESP-IDF",
      "patterns": ["(?<![-\\w])esp-idf(?![-\\w])"],
      "severity": "error",
      "message": "Use 'ESP-IDF' in prose; keep exact lowercase spelling in package names, commands, paths, and URLs."
    },
    {
      "id": "espressif-capitalization",
      "preferred": "Espressif",
      "patterns": ["\\bespressif\\b"],
      "severity": "error",
      "message": "Use 'Espressif' in prose."
    },
    {
      "id": "wokwi-capitalization",
      "preferred": "Wokwi",
      "patterns": ["\\bwokwi\\b"],
      "severity": "error",
      "message": "Use 'Wokwi' in prose."
    },
    {
      "id": "soc-capitalization",
      "preferred": "SoC",
      "patterns": ["\\bSOCs?\\b"],
      "severity": "error",
      "message": "Use 'SoC' or 'SoCs'."
    },
    {
      "id": "efuse-capitalization",
      "preferred": "eFuse",
      "patterns": ["\\befuses?\\b"],
      "severity": "error",
      "message": "Use 'eFuse' or 'eFuses'."
    },
    {
      "id": "mqtt-capitalization",
      "preferred": "MQTT",
      "patterns": ["\\bmqtt\\b"],
      "severity": "error",
      "message": "Use 'MQTT' in prose."
    },
    {
      "id": "ota-capitalization",
      "preferred": "OTA",
      "patterns": ["\\bota\\b"],
      "severity": "error",
      "message": "Use 'OTA' in prose."
    }
  ]
}
